{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision.schema.json",
  "$comment": "GENERATED by scripts/export_contracts.py - do not edit by hand. Two shapes exist today. DecisionReport = live agent path (request.report), free-text reasons, no reason_code. ScenarioReport = evaluated path (eval conditions), has reason_code, findings and simulation samples. snapshot_version lives on the request, not on the report. Gaps vs the original brief: no reason_code/rules/snapshot_version on DecisionReport; core must add them before the UI can rely on them.",
  "oneOf": [
    {
      "$ref": "#/$defs/DecisionReport"
    },
    {
      "$ref": "#/$defs/ScenarioReport"
    }
  ],
  "$defs": {
    "ActionType": {
      "enum": [
        "transfer_inventory",
        "create_purchase_order",
        "change_order_priority",
        "cancel_purchase_order"
      ],
      "title": "ActionType",
      "type": "string"
    },
    "DataQualityIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "missing_field",
            "stale_timestamp",
            "duplicate_record",
            "invalid_reference",
            "conflicting_quantity",
            "unsupported_status"
          ],
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        }
      },
      "required": [
        "code",
        "detail",
        "entity_id"
      ],
      "title": "DataQualityIssue",
      "type": "object"
    },
    "Decision": {
      "enum": [
        "approve",
        "block",
        "human_review",
        "abstain"
      ],
      "title": "Decision",
      "type": "string"
    },
    "ProposedAction": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "action_type": {
          "$ref": "#/$defs/ActionType"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "proposed_by": {
          "$ref": "#/$defs/Role"
        }
      },
      "required": [
        "action_id",
        "action_type",
        "parameters",
        "proposed_by"
      ],
      "title": "ProposedAction",
      "type": "object"
    },
    "Role": {
      "enum": [
        "viewer",
        "planner",
        "manager",
        "ai_agent"
      ],
      "title": "Role",
      "type": "string"
    },
    "SimulationEvent": {
      "additionalProperties": false,
      "properties": {
        "day": {
          "title": "Day",
          "type": "integer"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        }
      },
      "required": [
        "day",
        "description",
        "entity_id"
      ],
      "title": "SimulationEvent",
      "type": "object"
    },
    "SimulationReport": {
      "additionalProperties": false,
      "properties": {
        "simulation_id": {
          "title": "Simulation Id",
          "type": "string"
        },
        "snapshot_id": {
          "title": "Snapshot Id",
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/ProposedAction"
        },
        "final_state_diff": {
          "additionalProperties": true,
          "title": "Final State Diff",
          "type": "object"
        },
        "side_effects": {
          "items": {
            "type": "string"
          },
          "title": "Side Effects",
          "type": "array"
        },
        "violated_rules": {
          "items": {
            "type": "string"
          },
          "title": "Violated Rules",
          "type": "array"
        },
        "kpis": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Kpis",
          "type": "object"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "trace": {
          "items": {
            "$ref": "#/$defs/SimulationEvent"
          },
          "title": "Trace",
          "type": "array"
        }
      },
      "required": [
        "simulation_id",
        "snapshot_id",
        "action",
        "final_state_diff",
        "side_effects",
        "violated_rules",
        "kpis",
        "warnings",
        "trace"
      ],
      "title": "SimulationReport",
      "type": "object"
    },
    "DecisionReport": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "$ref": "#/$defs/Decision"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "missing_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Missing Evidence",
          "type": "array"
        },
        "simulation_report": {
          "anyOf": [
            {
              "$ref": "#/$defs/SimulationReport"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "data_quality_issues": {
          "items": {
            "$ref": "#/$defs/DataQualityIssue"
          },
          "title": "Data Quality Issues",
          "type": "array"
        },
        "report_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Id"
        },
        "explanation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explanation"
        }
      },
      "required": [
        "decision",
        "reasons",
        "missing_evidence"
      ],
      "title": "DecisionReport",
      "type": "object"
    },
    "SimulationSummary": {
      "type": "object",
      "properties": {
        "unsafe": {
          "type": "boolean"
        },
        "max_warehouse_capacity_pct": {
          "type": "number"
        },
        "stockout_count": {
          "type": "number"
        },
        "violated_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kpis": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "possible_hidden_po_sampled": {
          "type": "boolean"
        }
      },
      "required": [
        "unsafe",
        "violated_rules",
        "kpis",
        "warnings"
      ]
    },
    "ScenarioReport": {
      "type": "object",
      "properties": {
        "decision": {
          "enum": [
            "approve",
            "block",
            "human_review"
          ]
        },
        "detail": {
          "type": "object",
          "properties": {
            "reason_code": {
              "type": "string"
            },
            "findings": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/DataQualityIssue"
              }
            },
            "simulations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SimulationSummary"
              }
            }
          },
          "required": [
            "reason_code",
            "findings",
            "simulations"
          ]
        }
      },
      "required": [
        "decision",
        "detail"
      ]
    }
  }
}
