        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "request_id"
        ],
        "title": "RequestCreated"
      },
      "RequestIn": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "RequestIn"
      },
      "RequestOut": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "decided",
              "needs_review",
              "approved",
              "rejected",
              "applied",
              "failed",
              "needs_clarification",
              "stale_decision"
            ],
            "title": "Status"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "created_by": {
            "type": "string",
            "title": "Created By"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/AgentStep"
            },
            "type": "array",
            "title": "Steps",
            "default": []
          },
          "proposed_action": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Proposed Action"
          },
          "decision": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "approve",
                  "block",
                  "human_review"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Decision"
          },
          "report": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Report"
          },
          "explanation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Explanation"
          },
          "clarification": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Clarification"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "status",
          "text",
          "created_by",
          "created_at"
        ],
        "title": "RequestOut"
      },
      "ReviewIn": {
        "properties": {
          "comment": {
            "type": "string",
            "minLength": 1,
            "title": "Comment"
          }
        },
        "type": "object",
        "required": [
