            "type": "array",
            "title": "Findings"
          }
        },
        "type": "object",
        "required": [
          "stock_by_warehouse",
          "capacity_use",
          "freshness",
          "findings"
        ],
        "title": "StateSummary"
      },
      "ValidationError": {
        "properties": {
