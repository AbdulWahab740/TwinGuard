      },
      "ScenarioRunOut": {
        "properties": {
          "report": {
            "additionalProperties": true,
            "type": "object",
            "title": "Report"
          },
          "conditions": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Conditions"
          },
          "truth": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
