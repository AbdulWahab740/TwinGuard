            "default": "bearer"
          },
          "role": {
            "type": "string",
            "enum": [
              "planner",
              "manager",
              "viewer"
            ],
            "title": "Role"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "role"
        ],
        "title": "LoginOut"
      },
