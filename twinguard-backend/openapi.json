      "StateSummary": {
        "properties": {
          "stock_by_warehouse": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Stock By Warehouse"
          },
          "capacity_use": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Capacity Use"
          },
          "freshness": {
            "type": "string",
            "title": "Freshness"
          },
          "findings": {
            "items": {
              "additionalProperties": true,
