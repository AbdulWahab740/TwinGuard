ENV=prod         # dev allows the weak default JWT secret; never use dev in a deployment
SUPABASE_URL=
SUPABASE_KEY=          # service-role key; server-side only
JWT_SECRET=          # required: 32+ random chars, e.g. python -c "import secrets;print(secrets.token_hex(32))"
LLM_PROVIDER=fake      # fake | openai_compatible
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
ALLOW_AUTO_APPLY=false
SEED_PASSWORD=          # used once by scripts/seed.py for the 3 demo users
