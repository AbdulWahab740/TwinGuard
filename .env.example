# Copy to twinguard-backend/.env and fill in. Never commit the real file.
ENV=prod                 # dev allows a weak JWT secret; never use dev when deployed
SUPABASE_URL=            # https://<project-ref>.supabase.co
SUPABASE_KEY=            # service-role (secret) key; server-side only, never in the frontend
JWT_SECRET=              # required, 32+ random chars: python -c "import secrets;print(secrets.token_hex(32))"
SEED_PASSWORD=           # password for the 3 demo users, used once by scripts/seed.py
LLM_PROVIDER=fake        # fake (offline, default) | openai_compatible
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
ALLOW_AUTO_APPLY=false   # false = a manager must approve every apply
